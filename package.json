{
  "name": "worksheet-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server/index.ts",
    "build": "vue-tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --import tsx src/server/index.ts",
    "worksheet": "node --import tsx src/cli/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fontkit": "^2.0.4",
    "hanzi-writer-data": "^2.0.1",
    "playwright": "1.64.1",
    "tsx": "^4.20.0",
    "vue": "^3.5.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/fontkit": "^2.0.8",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.1.0"
  }
}
